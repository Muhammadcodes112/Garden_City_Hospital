# Postgres connection string (Neon or Supabase). Use the pooled connection
# string if your provider offers one.
DATABASE_URL=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of this app. BETTER_AUTH_URL is used server-side (session
# cookies, share-link origin fallback); NEXT_PUBLIC_BETTER_AUTH_URL is the
# same value exposed to the browser. Both should match in every environment.
BETTER_AUTH_URL=
NEXT_PUBLIC_BETTER_AUTH_URL=

# Required to register a new admin account via /sign-up. Anyone who doesn't
# have this code cannot create an account — treat it like a password and
# share it only with people who should be able to provision admins.
ADMIN_SIGNUP_CODE=

# Optional. HMAC secret used to derive the rotating admin access code. If
# unset, falls back to BETTER_AUTH_SECRET, then to a hardcoded default in
# src/lib/access-code.ts — set this explicitly in production so the fallback
# is never relied on.
ACCESS_CODE_SECRET=

# Optional. Email of the primary Super Admin account, protected from being
# demoted to a regular admin. Also used by scripts/create-super-admin.ts. If
# unset, falls back to a hardcoded email in both of those call sites.
SUPER_ADMIN_EMAIL=

# Optional. Bearer token checked by /api/cron/cleanup-trash (also accepts
# Vercel Cron's own authorization header). If unset, that endpoint is left
# unauthenticated — set this in production.
CRON_SECRET=

# Optional: path to a local Chrome/Chromium executable for PDF generation in
# development. Not needed in production (Vercel) — @sparticuz/chromium
# supplies the binary there.
CHROME_EXECUTABLE_PATH=

# Optional. Set to any non-empty value to log PDF margin/header-footer debug
# info from src/lib/pdf.ts during local troubleshooting.
PDF_DEBUG=

# Vercel Blob store token, used for file attachments sent in Messages, and
# by the daily backup workflow (.github/workflows/backup-db.yml — add this
# as a GitHub repo secret too, not just here).
# Connect a Blob store to this project in the Vercel dashboard, then run
# `vercel env pull` to get this locally — it's set automatically in
# production. Blob objects have no private ACL, so the app never hands this
# URL to a browser: it's stored server-side only and files are served through
# an authenticated proxy route that checks conversation participation.
# Also used by src/lib/pdf-cache.ts to cache rendered PDFs/page images
# (private-access blobs); leaving it unset just disables that cache.
BLOB_READ_WRITE_TOKEN=

# Sentry error monitoring. SENTRY_DSN covers server + edge; the client
# bundle needs its own NEXT_PUBLIC_ copy of the same DSN since only
# NEXT_PUBLIC_ vars reach the browser. Leaving either unset makes the SDK a
# no-op there — safe to leave blank until a real project exists.
# src/lib/sentry-scrub.ts strips patient names, hospital numbers, form data,
# and message bodies from every event and breadcrumb before it's sent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional, build-time only. Needed to upload source maps and tag releases
# when running `next build` — without these the build still succeeds, just
# without readable stack traces in Sentry. Get these from Sentry → Settings
# → Auth Tokens (org) / your project's slug (project).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
